<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>The Cozy Bistro | Menu</title>
    <style>
        /* Base Styling */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: #fcf9f5;
            color: #333;
            line-height: 1.6;
        }

        /* Header Section */
        header {
            background-color: #1e2229;
            color: #fff;
            text-align: center;
            padding: 40px 20px;
        }

        header h1 {
            font-size: 2.5rem;
            color: #ffbc42;
            margin-bottom: 5px;
        }

        header p {
            font-style: italic;
            color: #ddd;
        }

        /* Container & Grid Setup */
        .container {
            max-width: 1000px;
            margin: 40px auto;
            padding: 0 20px;
        }

        .category-title {
            font-size: 1.8rem;
            color: #1e2229;
            border-bottom: 2px solid #ffbc42;
            padding-bottom: 5px;
            margin: 30px 0 20px 0;
        }

        .menu-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
        }

        /* Menu Item Card */
        .menu-item {
            background: #ffffff;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.05);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            border-left: 4px solid #ffbc42;
        }

        .menu-item-header {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            margin-bottom: 8px;
        }

        .item-name {
            font-weight: bold;
            font-size: 1.2rem;
            color: #1e2229;
        }

        .item-price {
            font-weight: bold;
            color: #e67e22;
            font-size: 1.1rem;
        }

        .item-description {
            font-size: 0.95rem;
            color: #666;
        }

        /* Footer Section */
        footer {
            background-color: #1e2229;
            color: #aaa;
            text-align: center;
            padding: 20px;
            margin-top: 50px;
            font-size: 0.9rem;
        }
    </style>
</head>
<body>

    <!-- Header Section -->
    <header>
        <h1>The Cozy Bistro</h1>
        <p>Fresh ingredients, timeless recipes, made with love.</p>
    </header>

    <!-- Main Content Container -->
    <div class="container">

        <!-- Category: Appetizers -->
        <h2 class="category-title">Appetizers</h2>
        <div class="menu-grid">
            <div class="menu-item">
                <div class="menu-item-header">
                    <span class="item-name">Garlic Parmesan Knots</span>
                    <span class="item-price">$7.99</span>
                </div>
                <p class="item-description">Freshly baked dough tied in knots, tossed in garlic butter, and topped with shredded fresh parmesan.</p>
            </div>
            <div class="menu-item">
                <div class="menu-item-header">
                    <span class="item-name">Stuffed Mushrooms</span>
                    <span class="item-price">$9.50</span>
                </div>
                <p class="item-description">Plump mushroom caps packed with seasoned cream cheese, herbs, and breadcrumbs.</p>
            </div>
        </div>

        <!-- Category: Main Courses -->
        <h2 class="category-title">Main Courses</h2>
        <div class="menu-grid">
            <div class="menu-item">
                <div class="menu-item-header">
                    <span class="item-name">Classic Margherita Pizza</span>
                    <span class="item-price">$14.99</span>
                </div>
                <p class="item-description">House-made tomato sauce, fresh mozzarella, extra virgin olive oil, and fresh basil leaves on a crispy crust.</p>
            </div>
            <div class="menu-item">
                <div class="menu-item-header">
                    <span class="item-name">Tuscan Garlic Chicken</span>
                    <span class="item-price">$18.25</span>
                </div>
                <p class="item-description">Pan-seared chicken breast served with a rich, creamy garlic sauce, spinach, and sun-dried tomatoes over pasta.</p>
            </div>
            <div class="menu-item">
                <div class="menu-item-header">
                    <span class="item-name">Grilled Salmon Fillet</span>
                    <span class="item-price">$22.00</span>
                </div>
                <p class="item-description">Atlantic salmon grilled to perfection, drizzled with a lemon-herb butter glaze, served with asparagus.</p>
            </div>
        </div>

        <!-- Category: Desserts & Drinks -->
        <h2 class="category-title">Desserts & Drinks</h2>
        <div class="menu-grid">
            <div class="menu-item">
                <div class="menu-item-header">
                    <span class="item-name">Molten Chocolate Lava Cake</span>
                    <span class="item-price">$8.50</span>
                </div>
                <p class="item-description">Warm chocolate cake with a delightfully liquid chocolate center, served with vanilla bean ice cream.</p>
            </div>
            <div class="menu-item">
                <div class="menu-item-header">
                    <span class="item-name">Iced Caramel Macchiato</span>
                    <span class="item-price">$4.75</span>
                </div>
                <p class="item-description">Rich espresso layered with cold milk and sweet vanilla syrup, finished with a heavy caramel drizzle.</p>
            </div>
        </div>

    </div>

    <!-- Footer Section -->
    <footer>
        <p>&copy; 2026 The Cozy Bistro. All rights reserved.</p>
    </footer>

</body>
</html>
